MILOCO_BASE_URL=
MILOCO_PASSWORD=

CAMERA_ID=1234567890
RTSP_URL=rtsp://192.168.1.11:8554/your_stream_name

# Set to 0 to publish video only. Cameras sending G711A/G711U get an audio track;
# other codecs are logged and skipped.
ENABLE_AUDIO=1

# Miloco hides cameras its built in denylist rejects, including models that work.
# List them here, comma separated, to make them selectable again.
# CAMERA_ALLOW_MODELS=chuangmi.camera.021a04
