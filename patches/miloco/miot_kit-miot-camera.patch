+    # the shipped lists reject cameras that do work, so let a deployment name its own
+    # models instead of having to mount a whole edited yaml
+    for model in [item.strip() for item in os.getenv("CAMERA_ALLOW_MODELS", "").split(",") if item.strip()]:
+        fields = model.split(".")
+        if len(fields) < 2:
+            _LOGGER.error("invalid model in CAMERA_ALLOW_MODELS, %s", model)
+            continue
+        device_class = fields[1]
+        if device_class not in result.allow_classes:
+            result.allow_classes.append(device_class)
+        was_denied = result.denylist.get(device_class, {}).pop(model, None) is not None
+        # a class is filtered by whichever list holds it, so an allowlist class needs the entry adding
+        if device_class not in result.denylist:
+            result.allowlist.setdefault(device_class, {})[model] = {
+                "name": model, "reason": "allowed by CAMERA_ALLOW_MODELS"}
+        _LOGGER.info("camera model allowed by CAMERA_ALLOW_MODELS, %s, was denied: %s", model, was_denied)
